[Unit]
Description=Pocket-R Tamagotchi (auto-start)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=gpio spi i2c
WorkingDirectory=@@APP_DIR@@
ExecStart=/usr/bin/python3 -u @@APP_DIR@@/app.py
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1
# SPI device node can be 0.0 or 0.1 depending on wiring/overlay; just ensure *some* spidev exists.
ExecStartPre=/bin/sh -c 'ls /dev/spidev* >/dev/null 2>&1 || { echo "Missing /dev/spidev* (enable SPI via raspi-config)"; exit 1; }'

[Install]
WantedBy=multi-user.target
