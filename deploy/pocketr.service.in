[Unit]
Description=Pocket-R Tamagotchi (auto-start)
After=systemd-modules-load.service pocketr-splash.service
Wants=pocketr-splash.service

[Service]
Type=simple
WorkingDirectory=@@APP_DIR@@
ExecStartPre=-/bin/systemctl stop pocketr-splash.service
# Wait briefly for SPI node; avoid 90s systemd device timeout jobs
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do test -c /dev/spidev0.0 && exit 0; sleep 0.1; done; echo "SPI /dev/spidev0.0 not ready"; exit 1'
ExecStart=/usr/bin/python3 @@APP_DIR@@/app.py
Restart=always
RestartSec=1
User=root
Environment=PYTHONUNBUFFERED=1
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
