[Unit]
Description=Pocket-R Boot Splash
Wants=dev-spidev0.0.device
After=dev-spidev0.0.device local-fs.target
Before=pocketr.service

[Service]
Type=simple
WorkingDirectory=@@APP_DIR@@
ExecStart=/usr/bin/python3 @@APP_DIR@@/splash.py
Restart=always
RestartSec=0.5
User=root
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'test -c /dev/spidev0.0 || { echo "Missing /dev/spidev0.0 (enable SPI)"; exit 1; }'

[Install]
WantedBy=multi-user.target
